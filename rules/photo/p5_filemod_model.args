-if
$MIMEType =~ /^image\// and ($FileModifyDate =~ /[1-9]/ and $Model)
-Directory<Photos/${FileModifyDate;s/\D//g;$_=length($_)>=14?substr($_,0,14):"";$_=$_?substr($_,0,4)."-".substr($_,4,2):"NoDate"}/${GeolocationCountry;s/[\\\/:*?"<>|]/_/g;$_=$_?$_:"NoLocation"}/${GeolocationRegion;s/[\\\/:*?"<>|]/_/g;$_=$_?$_:"Unknown"}/${GeolocationCity;s/[\\\/:*?"<>|]/_/g;$_=$_?$_:"Unknown"}/${Model;s/[\\\/:*?"<>|]/_/g}
-FileName<${FileModifyDate;s/\D//g;$_=length($_)>=14?substr($_,0,14):"";$_=$_?substr($_,0,8)."_".substr($_,8,6):"00000000_000000"}%-c.%e
