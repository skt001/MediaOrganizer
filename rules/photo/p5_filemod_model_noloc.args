-if
$MIMEType =~ /^image\// and ($FileModifyDate =~ /[1-9]/ and $Model) and not defined $GPSLatitude
-Directory<Photos/${FileModifyDate;s/\D//g;$_=length($_)>=14?substr($_,0,4)."-".substr($_,4,2):""}/NoLocation/${Model;s/[\\\/:*?"<>|]/_/g}
-FileName<${FileModifyDate;s/\D//g;$_=length($_)>=14?substr($_,0,8)."_".substr($_,8,6):""}%-c.%e
