-if
$MIMEType =~ /^video\// and $FileModifyDate =~ /[1-9]/
-Directory<Movies/${FileModifyDate;s/\D//g;$_=length($_)>=14?substr($_,0,4)."-".substr($_,4,2):""}/${GeolocationCountryNvl;s/[\\\/:*?"<>|]/_/g}/${GeolocationRegion;s/[\\\/:*?"<>|]/_/g}/${GeolocationCity;s/[\\\/:*?"<>|]/_/g}/${MakeNvl;s/[\\\/:*?"<>|]/_/g}
-FileName<${FileModifyDate;s/\D//g;$_=length($_)>=14?substr($_,0,8)."_".substr($_,8,6):""}%-c.%e
