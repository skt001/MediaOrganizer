-if
$MIMEType =~ /^image\// and ($DateTimeOriginal =~ /[1-9]/ and $Model) and defined $GPSLatitude
-Directory<Photos/${DateTimeOriginal;s/\D//g;$_=length($_)>=14?substr($_,0,4)."-".substr($_,4,2):""}/${GeolocationCountry;s/[\\\/:*?"<>|]/_/g}/${GeolocationRegion;s/[\\\/:*?"<>|]/_/g}/${GeolocationCity;s/[\\\/:*?"<>|]/_/g}/${Model;s/[\\\/:*?"<>|]/_/g}
-FileName<${DateTimeOriginal;s/\D//g;$_=length($_)>=14?substr($_,0,8)."_".substr($_,8,6):""}${SubSecTimeOriginal;$_="_".$_ if $_}%-c.%e
